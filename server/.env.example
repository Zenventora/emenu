# ─── Database ─────────────────────────────────────────────────────────────────
# Local:      postgresql://postgres@localhost:5432/emenu_dev
# Supabase:   postgresql://postgres:[PASSWORD]@db.xxxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres@localhost:5432/emenu_dev"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development          # → production on Render

# Your app's public URL (no trailing slash)
# Local:      http://localhost:4000
# Production: https://emenu-app.onrender.com
APP_URL=http://localhost:4000

# ─── JWT Secrets — MUST be long random strings in production ──────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change_this_to_64_char_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_64_char_random_string

# ─── Zoho Mail SMTP ───────────────────────────────────────────────────────────
# Get App Password: Zoho Mail → Settings → Security → App Passwords
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=your-email@zohomail.in
SMTP_PASS=your_zoho_app_password

# ─── QR Code base URL ─────────────────────────────────────────────────────────
# Local:      http://localhost:4000/menu
# Production: https://emenu-app.onrender.com/menu
MENU_BASE_URL=http://localhost:4000/menu
