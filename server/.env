# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Change host/user/pass/db to match your local Postgres setup
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emenu_dev"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Public URL for QR codes (what gets encoded into the QR)
MENU_BASE_URL=http://localhost:4000/menu

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=emenu_dev_access_secret_32chars_here
JWT_REFRESH_SECRET=emenu_dev_refresh_secret_32chars_here

# ─── Email (SMTP) — leave blank for dev: OTP will print to console ────────────
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
